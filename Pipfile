[[source]]
name = "pypi"
url = "https://pypi.org/simple"
verify_ssl = true

[dev-packages]
bandit = ">=1.7.5"
black = "==23.11.0"
pylint = "==3.0.2"
ruff = "==0.8.4"

[packages]
aiohttp = "==3.13.2"
typing-extensions = ">=4.12.2"  # Required by aiohttp
audioop-lts = {version = "==0.2.2", markers = "python_version >= '3.13'"}
colorama = "==0.4.6"
"discord.py" = {version = "==2.6.3", extras = ["speed"]}
emoji = "==2.8.0"
isodate = "==0.6.1"
motor = "==3.7.1"
natural = "==0.2.0"
packaging = "==23.2"
parsedatetime = "==2.6"
dnspython = ">=2.8,<3"  # Required by pymongo
pymongo = ">=4.9,<5"  # Required by motor
python-dateutil = "==2.8.2"
python-dotenv = "==1.0.0"
uvloop = {version = ">=0.19.0", markers = "sys_platform != 'win32'"}
lottie = {version = "==0.7.2", extras = ["pdf"]}
setuptools = "*"  # Needed for lottie
requests = "==2.31.0"

[scripts]
bot = "python bot.py"
start = "python start.py"

[requires]
python_version = "3.12"
